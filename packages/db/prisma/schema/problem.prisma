// --- PROBLEMS ---

model Problem {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique // e.g., "two-sum"
  description String     @db.Text
  difficulty  Difficulty @default(EASY)
  rating      Int        @default(1500) // numeric difficulty, typical range 800–3500

  // Execution limits for a submission against this problem.
  //
  // timeLimit_ms is the TOTAL CPU budget for the whole run, not a per-case
  // allowance. The judge batches many test cases into one sandbox invocation,
  // which reports a single aggregate CPU number — a per-case limit isn't
  // observable there. Same semantic LeetCode shows: one limit for the run.
  //
  // memoryLimit_kb is peak memory for a single sandbox invocation. It resets
  // between chunks, so a case never fails because of allocations an earlier
  // case made.
  timeLimit_ms   Int @default(2000)
  memoryLimit_kb Int @default(262144) // 256 MB

  isPublished Boolean  @default(false)
  tier        UserTier @default(FREE)

  // Code generation metadata. Split into scalar fields for queryability + type safety.
  methodName String
  returnType String
  // args shape: [{ name: string, type: string }]
  args       Json

  // Relations
  testCases   TestCase[]
  templates   CodeTemplate[]
  topics      ProblemTopic[]
  submissions Submission[]
  solutions   Solution[]
  discussPosts DiscussPost[]
  stats       ProblemStats?

  createdById String
  createdBy   User       @relation("AuthoredProblems", fields: [createdById], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([difficulty])
  @@index([rating])
  @@index([createdAt])
  @@index([createdById])
  @@index([isPublished])
  @@index([tier])
}

// --- TEST CASES ---

model TestCase {
  id           String   @id @default(cuid())
  problemId    String
  problem      Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  // Inline storage for small cases (read directly, no GCS roundtrip).
  inlineInput  Json?
  inlineOutput Json?

  // GCS storage for large cases. File contents follow the same JSON shape.
  inputPath    String?
  outputPath   String?

  // Metadata
  isSample    Boolean  @default(false) // Visible to user in "Examples"
  explanation String?  @db.Text        
  order       Int      @default(0)     // Author-controlled sequence

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([problemId])
  @@index([problemId, order])
}

// --- LANGUAGE TEMPLATES ---

model CodeTemplate {
  id          String   @id @default(cuid())
  language    Language
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  starterCode String   @db.Text
  driverCode  String   @db.Text

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([problemId, language])
  @@index([problemId])
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// Map to Judge0 IDs in code, not in the DB.
enum Language {
  CPP
  JAVA
  PYTHON
  JAVASCRIPT
  TYPESCRIPT
  GO
  RUST
}

// --- PROBLEM STATS ---
//
// Aggregate counters maintained by the `update-problem-stats` worker.
// Kept in a 1:1 sidecar table (not on Problem) so high-frequency counter
// writes don't contend with edits to the core Problem row.
//
// Idempotency: every applied submission is recorded in ProblemStatsLedger
// (PK = submissionId). The consumer inserts the ledger row first; a
// unique-violation means the job has already been applied and is skipped.
model ProblemStats {
  problemId String  @id
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  totalSubmissions    Int @default(0)
  acceptedSubmissions Int @default(0)

  updatedAt DateTime @updatedAt
}

model ProblemStatsLedger {
  submissionId String   @id
  problemId    String
  appliedAt    DateTime @default(now())

  @@index([problemId])
}

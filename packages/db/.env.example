# Postgres connection string used by Prisma CLI (migrate, generate, studio)
# and by the seed scripts in seed/.
# This is the SAME database as DATABASE_URL in apps/backend-core/.env and
# apps/judge/.env — keep them in sync.
#
# The judge is the exception to "identical string": it runs in a container, so
# its host is host.docker.internal, not localhost. It also connects as a scoped
# role rather than the app user. Same database, different credentials and host.
DATABASE_URL=postgresql://user:password@localhost:5432/litecode

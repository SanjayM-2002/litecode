PORT=3000

# Postgres connection string used by Prisma (also read by @litecode/db)
DATABASE_URL=postgresql://user:password@localhost:5432/litecode

REDIS_URL=redis://localhost:6379


JWT_SECRET=jwt-secret
JWT_EXPIRES_IN=7d

BULL_BOARD_USER=
BULL_BOARD_PASS=



RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

RAZORPAY_PLAN_ID_MONTHLY=
RAZORPAY_PLAN_ID_YEARLY=


# --- AI provider (premium features: hint / help / roast) ---
# Selects which provider AiService talks to. 'mock' returns canned text and
# requires no API key — useful for local dev. Unknown values fall back to mock.
# Valid: mock | openai | gemini | grok | openrouter
AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROK_API_KEY=
GROK_MODEL=grok-2-1212

# REFERER and TITLE are optional app-identification headers for their leaderboard.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=
OPENROUTER_TITLE=

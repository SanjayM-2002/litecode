# Postgres connection string used by Prisma (same instance as backend-core)
DATABASE_URL=postgresql://user:password@localhost:5432/litecode

# Redis / Valkey URL — same instance as backend-core
REDIS_URL=redis://localhost:6379

# Code execution backend. One of: "jdoodle" (default), "piston", "judge0".
JUDGE_PROVIDER=jdoodle

# JDoodle — get credentials at https://www.jdoodle.com/compiler-api/
# Free tier: 200 credits/day. No per-request timeout/memory knobs (platform defaults apply).
JDOODLE_BASE_URL=https://api.jdoodle.com/v1
JDOODLE_CLIENT_ID=replace-me-with-your-jdoodle-client-id
JDOODLE_CLIENT_SECRET=replace-me-with-your-jdoodle-client-secret
# When "true", logs the assembled request and throws instead of calling JDoodle.
# Useful for iterating on driver templates without burning credits — BullMQ retries on throw.
JDOODLE_DRY_RUN=false

# Piston — public instance is whitelist-only since 2026-02-15. Self-host for unrestricted use.
# Self-host: https://github.com/engineer-man/piston
PISTON_BASE_URL=https://emkc.org/api/v2/piston
# PISTON_API_KEY=  # only needed for some self-hosted gateways

# Judge0 (RapidAPI Community Edition) — only required if JUDGE_PROVIDER=judge0
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=replace-me-with-your-rapidapi-key

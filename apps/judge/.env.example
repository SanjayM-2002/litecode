# ── Postgres ────────────────────────────────────────────────────────────────
# Use a scoped role, not the app's user. The judge runs untrusted code, so it
# should only be able to read problems/test cases and update Submission.
#
#   GRANT SELECT ON "Problem", "TestCase", "CodeTemplate" TO litejudge;
#   GRANT SELECT, UPDATE (status, verdict, "testResults", runtime_ms, memory_kb,
#                         "errorMessage", "failedTestCaseId", "startedAt",
#                         "completedAt") ON "Submission" TO litejudge;
#
# The host depends on WHO is connecting — inside a container, "localhost" is
# the container itself, not your machine and not the Postgres container:
#
#   NestJS, native on the host          localhost:5432
#   Judge in Docker, PG published       host.docker.internal:5432   ← this setup
#   Judge in Docker, PG same network    postgres:5432
#
# FIRST BRING-UP: the litejudge role does not exist until you run the grants
# above. Start with the same user as backend-core (host swapped) and tighten
# afterwards — otherwise a missing GRANT fails identically to a bug in the
# verdict write, and you'll debug the wrong thing.
DATABASE_URL=postgresql://litejudge:password@host.docker.internal:5432/litecode

# ── RabbitMQ ────────────────────────────────────────────────────────────────
# Must be the SAME broker as AMQP_URL in apps/backend-core/.env — that app
# publishes, this one consumes, and they have to meet on one instance.
#
# CloudAMQP URLs include the vhost as the last path segment — don't drop it,
# or you get a confusing ACCESS_REFUSED.
AMQP_URL=amqp://guest:guest@localhost:5672/

# Leave this alone unless you're adding a second worker. The name doubles as
# the routing key, and while it equals judge.jobs.default the consumer also
# binds judge.jobs.high so premium submissions aren't silently discarded — see
# the REMOVE THIS note in internal/queue/consumer.go.
JUDGE_QUEUE=judge.jobs.default

# ── Redis (optional) ────────────────────────────────────────────────────────
# Used for worker heartbeats, which is how GET /health/deep on backend-core
# knows a judge is alive. Without it the worker runs fine but reports as down.
# Same host rules as Postgres: host.docker.internal from inside the container.
REDIS_URL=redis://host.docker.internal:6379

# ── Sandbox ─────────────────────────────────────────────────────────────────
# isolate = the real thing. Linux only, so this means running in Docker.
# local   = NO ISOLATION AT ALL. Only for `go run` on macOS, where namespaces
#           and cgroups do not exist. Logs a loud warning at startup.
#
# NOTE: docker-compose passes this file with env_file, which OVERRIDES the
# Dockerfile's ENV. So this value wins — it must say isolate for the container.
JUDGE_SANDBOX=isolate
ISOLATE_BIN=/usr/local/bin/isolate

# Sandbox concurrency, and also the isolate box-id pool size. Should be
# (cores - 2): sandboxes are CPU-bound, and oversubscribing cores inflates
# every measured runtime — which on a judge turns correct solutions into TLEs,
# because time is part of the output rather than just telemetry.
# Inside Docker Desktop the container sees the VM's CPUs, not your 8.
JUDGE_CONCURRENCY=2

# ── Runtime ─────────────────────────────────────────────────────────────────
# Include path holding the precompiled bits/stdc++.h.gch and json.hpp.
CPP_INCLUDE_DIR=/opt/judge/pch

# Local content-addressed cache for large (GCS-backed) test cases.
CACHE_DIR=/var/lib/judge/cache

# ── Logging ─────────────────────────────────────────────────────────────────
# debug prints the numbered CHECKPOINT lines for every submission.
LOG_LEVEL=debug
LOG_FORMAT=text
